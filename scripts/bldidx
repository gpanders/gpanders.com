#!/usr/bin/env node
// Generate a lunr search index from the full site index.json
// Usage:
//
// 	bldidx < public/index.json > static/lunr.json
//
// Once the index is created and output to the 'static' directory, the `hugo`
// command must be run again in order to include the 'lunr.json' file in the
// generated site.

const lunr = require("lunr");
const stdin = process.stdin;
const stdout = process.stdout;

let buffer = [];

stdin.resume();
stdin.setEncoding("utf8");

stdin.on("data", (data) => buffer.push(data));
stdin.on("end", () => {
	const items = JSON.parse(buffer.join(""));
	const idx = lunr(function () {
		this.ref("title");
		this.field("title");
		this.field("permalink");
		this.field("contents");
		this.field("tags");

		items.forEach((item) => this.add(item), this);
	});

	stdout.write(JSON.stringify(idx));
});
