{
    "$schema": "https://unpkg.com/wrangler/config-schema.json",
    "name": "www",
    "main": "./src/index.ts",
    "compatibility_date": "2026-11-08",
    "workers_dev": false,
    "preview_urls": true,
    "upload_source_maps": true,
    "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "none",
        // Only search routes invoke the Worker; everything else is served straight from assets.
        "run_worker_first": ["/api/*", "/search", "/search/"],
    },
    "routes": [{ "pattern": "gpanders.com", "custom_domain": true }],
}
