{
    "$schema": "https://unpkg.com/wrangler/config-schema.json",
    "name": "www",
    "compatibility_date": "2026-11-08",
    "workers_dev": false,
    "preview_urls": true,
    "assets": {
        "directory": "./public",
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "none",
    },
    "routes": [{ "pattern": "gpanders.com", "custom_domain": true }]
}
