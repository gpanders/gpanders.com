{{/*
    Smaller version of the full index.json file at the root of the project
    directory. This file contains only the data needed to display search
    results on the HTML search page.
*/}}
{{- $.Scratch.Add "index" slice -}}
{{- range where .Site.RegularPages "Section" "in" site.Params.mainSections  -}}
    {{- $.Scratch.Add "index" (dict "title" .Title "date" (dateFormat "2006-01-02" .Date) "permalink" .RelPermalink) -}}
{{- end -}}
{{- $.Scratch.Get "index" | jsonify -}}
