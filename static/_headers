  Content-Security-Policy: default-src 'self'; object-src 'none'; style-src 'self' 'unsafe-inline'; script-src 'self'
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff

/index.xml
  Content-Type: application/xml; charset=utf-8
  X-Content-Type-Options: nosniff
